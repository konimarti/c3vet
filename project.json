{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  // Libraries to use for all targets. Both are vendored as git submodules
  // under lib/ (lib/lexer.c3l, lib/parser.c3l) rather than fetched by a
  // package manager.
  "dependencies": [ "lexer", "parser" ],
  "authors": [ "Koni Marti <koni.marti@gmail.com>" ],
  "version": "0.2.0",
  "sources": [ "src/c3vet/**" ],
  // Testdata lives in testdata/ at the project root, NOT under test/:
  // those files are read by the harness, never compiled into the test
  // binary. c3c has no exclude glob, so separate directories is the way.
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    // The vet binary.
    "c3vet": {
      "type": "executable",
      "sources": [ "src/cli/**" ],
    },
  },
  "cpu": "generic",
  "opt": "O0"
}
