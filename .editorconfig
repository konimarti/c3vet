root = true

[*.c3]
c3f_style                  = strict
c3f_sort_imports           = all
indent_style               = tab
indent_size                = 4
tab_width                  = 4
end_of_line                = keep
insert_final_newline       = true
max_line_length            = 80
c3f_line_breaks            = wrap_rewrite
c3f_brace_style            = allman
c3f_else_style             = follow
c3f_while_style            = own_line
c3f_one_line_blocks        = expand
c3f_case_indent            = indent
c3f_compile_time_indent    = indent
c3f_continuation           = keep
c3f_spacing                = strict
c3f_space_after_cast       = false
c3f_pointer_style          = type
c3f_space_inside_brackets  = keep
c3f_space_inside_braces    = keep
c3f_max_blank_lines        = 2
c3f_trim_block_blanks      = true
c3f_top_level_decls        = line
c3f_compile_time_body      = line
c3f_align                  = keep
c3f_align_comments         = keep
c3f_magic_comma            = true
c3f_wrap_lists             = fill
